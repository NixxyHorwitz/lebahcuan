{
  "manifest_version": 3,
  "name": "LebahCuan YT Scrapper",
  "version": "1.2.0",
  "description": "Scrape YouTube video IDs, titles & durations on scroll, and export them as clean JSON ready for LebahCuan.",
  "permissions": [
    "storage",
    "clipboardWrite"
  ],
  "host_permissions": [
    "*://*.youtube.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "LebahCuan YT Scrapper"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
